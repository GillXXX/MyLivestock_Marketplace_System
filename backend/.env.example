PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=herdmarket_db
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Comma-separated list of origins allowed to call this API (no trailing
# slashes). Defaults to http://localhost:3000 for local development.
CORS_ORIGIN=http://localhost:3000

# The frontend's base URL, used to build links sent in emails (e.g. the
# password reset link). Defaults to http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# SMTP settings for sending real emails (currently just password reset).
# Works with any provider: Gmail, SendGrid, Mailgun, Resend, Amazon SES,
# a self-hosted server, etc. — just supply that provider's SMTP credentials.
# If EMAIL_HOST is left blank, no email is actually sent; the reset link is
# printed to the server console instead, so local dev works with no setup.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=HerdMarket <no-reply@herdmarket.local>

# Set to "true" only when running behind a real reverse proxy (Render,
# Railway, Heroku, nginx, etc.) — needed for login rate limiting and
# req.ip to see the real client IP instead of the proxy's. Leave false/
# unset for local development, since trusting X-Forwarded-For otherwise
# lets a client spoof its IP and bypass rate limiting.
TRUST_PROXY=false

# Used only by createAdmin.js when seeding the first admin account.
# If ADMIN_PASSWORD is left blank, a random one is generated and printed
# once — save it immediately, it is not stored anywhere.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Object storage for uploads (profile photos, listing images/documents,
# verification documents). Works with any S3-compatible provider: AWS S3,
# Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO, etc.
#
# If S3_BUCKET is left blank, uploads fall back to local disk storage
# (fine for local dev, but files won't survive a redeploy in production).
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only needed for non-AWS providers (R2, Spaces, B2, MinIO, ...) — the
# S3-compatible API endpoint for your provider/account.
S3_ENDPOINT=

# Required for MinIO and some self-hosted S3-compatible servers.
S3_FORCE_PATH_STYLE=false

# Only set this if your provider supports per-object ACLs (AWS S3 does;
# Cloudflare R2 does not — leave blank for R2 and make the bucket/objects
# public via your provider's dashboard or a bucket policy instead).
S3_ACL=

# The base URL files are actually publicly reachable at. Required for
# every provider except plain AWS S3 with no custom domain (which can
# derive this automatically). Examples:
#   R2 public dev URL:      https://pub-xxxxxxxx.r2.dev
#   R2 custom domain:       https://cdn.yourdomain.com
#   DigitalOcean Spaces:    https://your-bucket.nyc3.digitaloceanspaces.com
S3_PUBLIC_URL=
